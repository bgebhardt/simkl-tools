# Copy this file to .env and fill in your values, then: source .env
# (or use direnv: echo 'dotenv' > .envrc && direnv allow)

# Required — your SIMKL developer app client ID
# Create one at https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=your_client_id_here

# Required for authenticated operations (list, move, mark-watched)
# Obtain via the SIMKL PIN/device-code OAuth flow:
#   1. GET https://api.simkl.com/oauth/pin?client_id=YOUR_CLIENT_ID
#   2. Visit the user_code URL and approve
#   3. Poll GET https://api.simkl.com/oauth/pin/DEVICE_CODE?client_id=YOUR_CLIENT_ID
#      until result="approved" — response contains access_token
SIMKL_ACCESS_TOKEN=your_access_token_here

# Optional — override the app identity sent with every request
# SIMKL_APP_NAME=simkl-tools
# SIMKL_APP_VERSION=0.1.0

# Required for `providers` (TMDB watch-provider lookup) — set ONE of these:
# API key (v3 auth, sent as ?api_key=):
# TMDB_API_KEY=your_tmdb_api_key_here
# OR read access token (v4 auth, sent as Bearer) — takes precedence if both are set:
# TMDB_BEARER_TOKEN=your_tmdb_read_access_token_here
# TMDB_ACCESS_TOKEN is also accepted as an alias for TMDB_BEARER_TOKEN
